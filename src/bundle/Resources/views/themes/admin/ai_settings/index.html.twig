{% extends "@ibexadesign/ui/layout.html.twig" %}

{% trans_default_domain 'masilia_ibexa_ai' %}

{% block body_class %}ibexa-ai-settings-react-view{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('ibexa-admin-ui-ai-settings-react-css', null, 'ibexa') }}
{% endblock %}

{% block breadcrumbs %}
    {% include '@ibexadesign/ui/breadcrumbs.html.twig' with { items: [
        { value: 'breadcrumb.admin'|trans },
        { value: 'settings.title'|trans }
    ]} %}
{% endblock %}

{% block title %}{{ 'settings.title'|trans }}{% endblock %}

{% block header %}
    {% include '@ibexadesign/ui/page_title.html.twig' with {
        title: 'settings.title'|trans,
    } %}
{% endblock %}

{% block content %}
    <div id="ai-settings-react-root"></div>
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('ibexa-admin-ui-ai-settings-react-js', null, 'ibexa') }}
{% endblock %}
