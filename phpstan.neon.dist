includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    excludePaths:
        # The names the public API had until 0.5: each only aliases its type of Masilia\Contracts\IbexaAi (gone in 1.0).
        - src/lib/Os/Capability.php
        - src/lib/Os/CapabilityResult.php
        - src/lib/Os/Preview.php
        - src/lib/Os/Risk.php
        - src/lib/Os/Skill.php
        - src/bundle/Os/Selftest/SelftestScenario.php
        - src/bundle/Os/Selftest/SelftestContext.php
        - src/bundle/Support/ImageGeneratorInterface.php
        - src/bundle/Support/ImageGenerationResult.php
    # The remarks that existed when the baseline was made are in phpstan-baseline.neon: fix them and remove them from it,
    # never add to it. A new remark fails the build.
    reportUnmatchedIgnoredErrors: true
