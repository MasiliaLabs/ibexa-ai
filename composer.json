{
    "name": "masilia/ibexa-ai",
    "description": "AI assistant for Ibexa CMS 5: provider layer, content suggestions, agent with approval flow (Neuron AI)",
    "type": "ibexa-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ibexa/core": "^5.0",
        "neuron-core/neuron-ai": "^4.1",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\IbexaAi\\": "src/lib/",
            "Masilia\\Bundle\\IbexaAi\\": "src/bundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\IbexaAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse",
        "test": ["@phpunit", "@phpstan"]
    },
    "config": {
        "sort-packages": true
    }
}
