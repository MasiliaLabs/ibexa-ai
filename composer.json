{
    "name": "masilia/ibexa-ai",
    "description": "AI assistant for Ibexa CMS 5: provider layer, content suggestions, agent with approval flow (Neuron AI)",
    "keywords": [
        "ibexa",
        "ibexa-dxp",
        "ibexa-5",
        "symfony-bundle",
        "ai",
        "llm",
        "assistant",
        "agent",
        "neuron-ai",
        "ag-ui"
    ],
    "homepage": "https://github.com/MasiliaLabs/ibexa-ai",
    "license": "MIT",
    "authors": [
        {
            "name": "MasiliaLabs",
            "homepage": "https://github.com/MasiliaLabs"
        }
    ],
    "support": {
        "issues": "https://github.com/MasiliaLabs/ibexa-ai/issues",
        "source": "https://github.com/MasiliaLabs/ibexa-ai",
        "security": "https://github.com/MasiliaLabs/ibexa-ai/security/policy"
    },
    "type": "ibexa-bundle",
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^2.20",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "ibexa/admin-ui": "^5.0",
        "ibexa/core": "^5.0",
        "ibexa/rest": "^5.0",
        "masilia/ibexa-admin-kit": "^0.1.1",
        "neuron-core/neuron-ai": "^4.1",
        "psr/cache": "^3.0",
        "psr/log": "^3.0",
        "symfony/config": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-csrf": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "ibexa/fieldtype-matrix": "^5.0",
        "ibexa/fieldtype-richtext": "^5.0",
        "ibexa/graphql": "^5.0",
        "novactive/ezseobundle": "^8.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ibexa/fieldtype-matrix": "Reads and writes matrix fields",
        "ibexa/fieldtype-richtext": "Reads and writes rich text fields",
        "ibexa/graphql": "Reads Markdown for rich text fields with its converter",
        "masilia/ibexa-ai-craft": "The assistant builds sites and pages with the blocks of a theme",
        "masilia/ibexa-ai-editor": "AI help in the content editing form (a suggestion per field, image generation)",
        "novactive/ezseobundle": "Reads and writes the SEO metas field (novaseometas)"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\IbexaAi\\": "src/lib/",
            "Masilia\\Contracts\\IbexaAi\\": "src/contracts/",
            "Masilia\\Bundle\\IbexaAi\\": "src/bundle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\IbexaAi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpunit": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": [
            "@phpunit",
            "@phpstan"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:masilia/ibexa-admin-kit.git"
        }
    ]
}
